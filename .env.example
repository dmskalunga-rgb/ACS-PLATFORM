# FOUNDATION configuration only. Values are safe local examples.
ACS_ENV=development
ACS_HOST=0.0.0.0
ACS_PORT=3000
ACS_LOG_LEVEL=info
ACS_WEB_ORIGIN=http://localhost:5173
ACS_IDENTITY_MODE=development-header
# Production example (values are identifiers/endpoints, never secrets):
# ACS_IDENTITY_MODE=oidc
# ACS_OIDC_ISSUER=https://identity.example.com/
# ACS_OIDC_AUDIENCE=acs-platform-api
# ACS_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# ACS_OIDC_ALLOWED_ALGORITHMS=RS256
# ACS_OIDC_CLOCK_TOLERANCE_SECONDS=60
# ACS_OIDC_JWKS_TIMEOUT_MS=2000
# ACS_OIDC_JWKS_CACHE_MS=300000
# ACS_OIDC_JWKS_COOLDOWN_MS=30000
DATABASE_URL=postgresql://acs_local:acs_local_only@localhost:5432/acs_foundation
ACS_CONTEXT_RESOLVER_DATABASE_URL=postgresql://acs_context_local:acs_context_local_only@localhost:5432/acs_foundation
ACS_SECURITY_AUDIT_DATABASE_URL=postgresql://acs_audit_local:acs_audit_local_only@localhost:5432/acs_foundation
ACS_TENANT_DATABASE_URL=postgresql://acs_tenant_local:acs_tenant_local_only@localhost:5432/acs_foundation
OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_API_BASE_URL=/api
VITE_DEV_IDENTITY_SUBJECT=
VITE_TENANT_ID=
