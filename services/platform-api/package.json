{
  "name": "@acs/platform-api",
  "version": "0.0.0-foundation",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src --max-warnings 0",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "vitest run src/platform-context.e2e.test.ts",
    "test:event-foundation:e2e": "vitest run src/event-foundation.e2e.test.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@acs/contracts": "workspace:*",
    "@acs/event-foundation": "workspace:*",
    "@acs/foundation": "workspace:*",
    "@acs/observability": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "fastify": "5.11.3",
    "jose": "catalog:",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.23.11"
  }
}
